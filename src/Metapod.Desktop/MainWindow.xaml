<Window x:Class="Metapod.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:local="clr-namespace:Metapod.Desktop" Title="Metapod" Width="1380" Height="920" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
  <DataTemplate x:Key="OverviewPage"><StackPanel>
   <TextBlock Text="Um projeto mais claro. Um agente mais útil." Style="{StaticResource Title}"/><TextBlock Text="Leia as configurações, entenda as origens e escolha o próximo ajuste." Style="{StaticResource Subtitle}"/>
   <UniformGrid Columns="3"><Border Style="{StaticResource Card}" Margin="0,0,16,18"><StackPanel><TextBlock Text="{Binding ResourceCount}" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Recursos encontrados"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,16,18"><StackPanel><TextBlock Text="{Binding FindingCount}" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Observações e diagnósticos"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Você decide" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Alterações passam por revisão"/></StackPanel></Border></UniformGrid>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Seu próximo passo" Style="{StaticResource Heading}"/><TextBlock Text="Selecione uma pasta. A leitura não executa hooks, servidores MCP ou plugins. Você pode editar recursos localmente, mesmo sem uma conversa com IA." Margin="0,0,0,20"/><WrapPanel><Button Content="Selecionar projeto" Command="{Binding ChooseProjectCommand}"/><Button Content="Ver recursos" Style="{StaticResource Secondary}" Command="{Binding NavigateCommand}" CommandParameter="Inventory"/><Button Content="Atualizar inventário" Style="{StaticResource Secondary}" Command="{Binding RefreshCommand}"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Diagnóstico local" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F3F5F7" CornerRadius="7" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Margin="0,5,0,0"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="InventoryPage"><StackPanel>
   <TextBlock Text="Agentes, skills e instruções" Style="{StaticResource Title}"/><TextBlock Text="Origem e escopo explícitos. O inventário não afirma o que está carregado em uma sessão." Style="{StaticResource Subtitle}"/>
   <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Filtrar por nome" Style="{StaticResource Label}"/><TextBox Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar recursos"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Tipo" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding KindFilterOptions}" SelectedItem="{Binding KindFilter}" AutomationProperties.Name="Filtrar por tipo"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Escopo" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ScopeFilterOptions}" SelectedItem="{Binding ScopeFilterOption}" AutomationProperties.Name="Filtrar por escopo"/></StackPanel></Grid><ListBox ItemsSource="{Binding FilteredResources}" SelectedItem="{Binding SelectedResource}" MaxHeight="380" Margin="0,12" AutomationProperties.Name="Recursos encontrados"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding KindLabel,StringFormat=[{0}]}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/><TextBlock Text="{Binding ScopeLabel,StringFormat=[{0}]}" Foreground="{StaticResource MutedBrush}"/></StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Path}" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Content="Abrir no editor" Command="{Binding EditCommand}"/><Button Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Criar um recurso" Style="{StaticResource Heading}"/><TextBlock Text="Agente: papel especializado. Skill: procedimento reutilizável. Instruções: contexto essencial." Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Nome" Style="{StaticResource Label}"/><TextBox Text="{Binding NewName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Tipo" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ResourceKinds}" SelectedItem="{Binding NewKind}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Escopo" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding NewScope}"/></StackPanel></Grid><Button Content="Preparar rascunho" Command="{Binding NewCommand}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="EditorPage"><StackPanel>
   <TextBlock Text="Editar com intenção" Style="{StaticResource Title}"/><TextBlock Text="O conteúdo só será salvo depois de revisar e aprovar a proposta." Style="{StaticResource Subtitle}"/>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding EditorPath}" Style="{StaticResource Heading}" FontSize="16"/><TextBlock Text="{Binding EditorScope}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/><TextBox Text="{Binding EditorText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeEditor}" Height="420" AutomationProperties.Name="Conteúdo do recurso"/><WrapPanel Margin="0,18,0,0"><Button Content="Revisar alteração" Command="{Binding PrepareCommand}"/><Button Content="Voltar aos recursos" Command="{Binding NavigateCommand}" CommandParameter="Inventory" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
   <TextBlock Text="Use descrições específicas e ferramentas mínimas necessárias. Campos JSON desconhecidos permanecem no texto; confira o diff antes de salvar." Style="{StaticResource Subtitle}"/>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="ReviewPage"><StackPanel><TextBlock Text="{Binding ReviewTitle}" Style="{StaticResource Title}"/><TextBlock Text="{Binding ReviewPath}" Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBox Text="{Binding ReviewDiff,Mode=OneWay}" IsReadOnly="True" Style="{StaticResource CodeEditor}" Height="390" AutomationProperties.Name="Diferenças propostas"/><Border Background="{StaticResource WarningBrush}" Padding="16" CornerRadius="8" Margin="0,18"><TextBlock Text="{Binding ReviewNotes}"/></Border><WrapPanel><Button Content="Aprovar e aplicar" Command="{Binding ApplyCommand}"/><Button Content="Voltar sem aplicar" Command="{Binding NavigateCommand}" CommandParameter="Overview" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border></StackPanel></DataTemplate>
  <DataTemplate x:Key="AssistantPage"><StackPanel><TextBlock Text="Pense junto com o assistente" Style="{StaticResource Title}"/><TextBlock Text="Claude Code instalado · resposta sem ferramentas · nenhuma gravação automática." Style="{StaticResource Subtitle}"/>
   <Border Style="{StaticResource Card}"><StackPanel><TextBox Text="{Binding ChatText,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="285" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0" AutomationProperties.Name="Conversa"/><WrapPanel Margin="0,14,0,0"><Button Content="Copiar conversa" Command="{Binding CopyCommand}" Style="{StaticResource Secondary}"/><Button Content="Levar resposta ao editor" Command="{Binding UseResponseCommand}" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="O que você quer melhorar?" Style="{StaticResource Heading}"/><TextBox Text="{Binding Question,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Sua pergunta"/><WrapPanel Margin="0,14,0,0"><Button Content="Revisar contexto e enviar" Command="{Binding ContextCommand}"/><Button Content="Criar skill" Command="{Binding PromptBlockCommand}" CommandParameter="skill" Style="{StaticResource Secondary}"/><Button Content="Agente ou skill?" Command="{Binding PromptBlockCommand}" CommandParameter="agent" Style="{StaticResource Secondary}"/><Button Content="Reduzir contexto" Command="{Binding PromptBlockCommand}" CommandParameter="tokens" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="ContextPage"><StackPanel><TextBlock Text="O que o assistente pode consultar" Style="{StaticResource Title}"/><TextBlock Text="Confira o texto efetivamente enviado. Você pode remover ou corrigir conteúdo antes de enviar." Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel>
   <CheckBox Content="Incluir conteúdo do recurso selecionado no inventário" IsChecked="{Binding IncludeResource}" Margin="0,0,0,14"/><WrapPanel><Button Content="Preparar novamente" Command="{Binding ContextCommand}" Style="{StaticResource Secondary}"/><Button Content="Selecionar arquivos de código" Command="{Binding AddCodeCommand}" Style="{StaticResource Secondary}"/><Button Content="Limpar contexto" Command="{Binding ClearContextCommand}" Style="{StaticResource Secondary}"/></WrapPanel><TextBlock Text="{Binding ContextState}" Margin="0,8,0,14" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding ContextPreview,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeEditor}" Height="330" AutomationProperties.Name="Contexto que será enviado"/>
   <Border Background="{StaticResource WarningBrush}" Padding="14" CornerRadius="7" Margin="0,16"><TextBlock Text="Enviar usa a autenticação do Claude instalado e pode consumir sua assinatura ou créditos de API. Segredos identificados são omitidos; revise porque a detecção não é perfeita. Ferramentas, skills, hooks e MCP ficam desabilitados para esta conversa; políticas administrativas ainda se aplicam."/></Border><Button Content="Enviar este contexto ao Claude" Command="{Binding SendCommand}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></DataTemplate>
  <DataTemplate x:Key="PluginsPage"><StackPanel><TextBlock Text="Plugins com origem e escopo claros" Style="{StaticResource Title}"/><TextBlock Text="Operações oficiais do CLI, com revisão individual antes de qualquer mudança." Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><Button Content="Consultar plugins instalados" Command="{Binding ListPluginsCommand}" HorizontalAlignment="Left"/><TextBox Text="{Binding PluginOutput,Mode=OneWay}" IsReadOnly="True" Style="{StaticResource CodeEditor}" Height="240" Margin="0,8,0,0" AutomationProperties.Name="Resultado do CLI de plugins"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Preparar operação" Style="{StaticResource Heading}"/><TextBlock Text="Plugin / origem (nome@marketplace)" Style="{StaticResource Label}"/><TextBox Text="{Binding PluginName,UpdateSourceTrigger=PropertyChanged}"/><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ação" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding PluginActions}" SelectedItem="{Binding PluginAction}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Escopo" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding PluginScopes}" SelectedItem="{Binding PluginScope}"/></StackPanel></Grid><TextBlock Text="Instalar não implica que o recurso já esteja carregado. Atualizações podem exigir reiniciar a sessão do Claude." Margin="0,4,0,16"/><Button Content="Revisar operação" Command="{Binding PlanPluginCommand}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></DataTemplate>
  <DataTemplate x:Key="DiscoverPage"><StackPanel><TextBlock Text="Ferramentas que resolvem um problema" Style="{StaticResource Title}"/><TextBlock Text="Aprenda quando usar. Compare adequação, manutenção, licença, dados enviados e custo." Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Jev / TypeSafe" Style="{StaticResource Heading}"/><TextBlock Text="Pode ser avaliado para decisões com opções bem definidas: classificação, ranking e seleção. Uma skill ensina a construir com a tecnologia; uma API ou ferramenta executa a decisão. Ter agentes, por si só, não justifica adicionar outra ferramenta." Margin="0,0,0,14"/><TextBlock Text="Como avaliar: compare acerto, latência e custo total em exemplos reais. Defina o comportamento em casos incertos. Instalar uma skill não ativa roteamento automático." Margin="0,0,0,16"/><TextBlock Text="Fonte do estudo: github.com/typesafe-ai/skills · pesquisa de 17/10/2026. Integração ainda não validada pelo aplicativo." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/><Button Content="Conversar sobre uso" Command="{Binding PromptBlockCommand}" CommandParameter="jev" HorizontalAlignment="Left"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pesquisar repositórios públicos" Style="{StaticResource Heading}"/><TextBox Text="{Binding SearchQuery,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Termos de busca no GitHub"/><Button Content="Pesquisar no GitHub" Command="{Binding SearchCommand}" HorizontalAlignment="Left" Margin="0,12,0,8"/><TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Subtitle}"/><ItemsControl ItemsSource="{Binding Repositories}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,10" Background="#F3F5F7" CornerRadius="7"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding Description}" Margin="0,6"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}"/><Button Content="Abrir repositório" Command="{Binding DataContext.OpenRepositoryCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="ProjectsPage"><StackPanel><TextBlock Text="Projetos do Claude Code" Style="{StaticResource Title}"/><TextBlock Text="Projetos detectados em ~/.claude/projects e uma seleção manual." Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><WrapPanel><Button Content="Escolher pasta manualmente" Command="{Binding ChooseProjectCommand}"/><Button Content="Atualizar inventário" Command="{Binding RefreshCommand}" Style="{StaticResource Secondary}"/></WrapPanel><ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" MaxHeight="390" Margin="0,16,0,12"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="Abrir projeto selecionado" Command="{Binding SelectProjectCommand}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></DataTemplate>
  <DataTemplate x:Key="ExecutionPage"><StackPanel><TextBlock Text="Perfis de execução" Style="{StaticResource Title}"/><TextBlock Text="Modelo principal e modelo padrão dos subagentes para a conversa iniciada pelo Metapod." Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><ItemsControl ItemsSource="{Binding Profiles}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,10" Background="#F3F5F7" CornerRadius="7"><StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Goal}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Notes}" Margin="0,6,0,0"/><TextBlock Text="Principal: {Binding MainModel} · Subagentes: {Binding SubagentModel}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,8"/><Button Content="Usar este perfil" Command="{Binding DataContext.SelectProfileCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding ProfileStatus}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}"><TextBlock Text="Opus para consulta e decisão é uma estratégia de trabalho. O CLI recebe o modelo principal com --model; não há parâmetro oficial --advisor. O modelo de subagente é passado somente ao processo filho do Metapod." TextWrapping="Wrap"/></Border></StackPanel></DataTemplate>
  <DataTemplate x:Key="CatalogPage"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Catálogo de skills e ferramentas" Style="{StaticResource Title}"/><TextBlock Text="Cadastre uma origem, filtre os itens e abra o detalhe antes de instalar ou configurar." Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Buscar por nome ou funcionalidade" Style="{StaticResource Label}"/><TextBox Text="{Binding CatalogFilter,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Filtros de projeto, tipo e estado serão aplicados à mesma lista quando houver inventário de plugins." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Bottom"><Button Content="Adicionar" Command="{Binding OpenAddCatalogModalCommand}" HorizontalAlignment="Stretch"/></StackPanel></Grid></Border></StackPanel><Grid Grid.Row="1"><ItemsControl ItemsSource="{Binding FilteredCatalogItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="300" Padding="18" Margin="0,0,14,14" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="{Binding KindLabel,StringFormat=[{0}]}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding Compatibility}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14"/><Button Content="Ver detalhes" Command="{Binding DataContext.LoadCatalogCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </Grid></Grid></DataTemplate>
  <DataTemplate x:Key="MemoryPage"><StackPanel><TextBlock Text="Memórias e contexto" Style="{StaticResource Title}"/><TextBlock Text="Escolha onde o contexto persiste e quais dados cada integração pode acessar." Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Memória nativa de subagentes" Style="{StaticResource Heading}"/><TextBlock Text="Agentes podem declarar memory: user, project ou local no front matter. O inventário mostra essa configuração e seu escopo."/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Conectores externos" Style="{StaticResource Heading}"/><TextBlock Text="Notion, Hermes ou um MCP externo devem declarar finalidade, dados acessados, retenção e escopo. Guarde tokens somente no Gerenciador de Credenciais do Windows sob um nome do Metapod; o valor não aparece e não entra em arquivos." TextWrapping="Wrap"/><TextBlock Text="A autenticação própria do Claude Code não é lida, importada nem exibida por este aplicativo." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></DataTemplate>
  <DataTemplate x:Key="HistoryPage"><StackPanel><TextBlock Text="Histórico e recuperação" Style="{StaticResource Title}"/><TextBlock Text="Histórico local deste aplicativo. Restaurar um arquivo também exige revisar e aprovar." Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" MinHeight="200" MaxHeight="460" AutomationProperties.Name="Histórico de alterações"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Display}"/><TextBlock Text="{Binding Scope}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="Revisar restauração do backup" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,16,0,8"/><TextBlock Text="Backups recuperam arquivos existentes editados pelo aplicativo. Criação de arquivos e efeitos externos de plugins não têm restauração automática." Foreground="{StaticResource MutedBrush}"/></StackPanel></Border></StackPanel></DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource SidebarBrush}"><DockPanel Margin="16,24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="m / metapod" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="8,0,0,6"/><TextBlock Text="SEU AMBIENTE DE IA" Foreground="#C1D0D5" FontSize="10" Margin="8,0,0,32"/><Border Background="#24424D" CornerRadius="8" Padding="14" Margin="0,0,0,28"><StackPanel><TextBlock Text="{Binding ProjectName}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Windows · Claude Code" Foreground="#C1D0D5" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="LOCAL · REVISÁVEL" Foreground="#C1D0D5" FontSize="10" Margin="8,0,0,12"/><TextBlock Text="Configurações claras.&#10;Mudanças conscientes." Foreground="#90A8B1" FontSize="12" Margin="8,0,0,12"/></StackPanel><StackPanel>
   <RadioButton Content="Visão geral" Style="{StaticResource Nav}" GroupName="Nav" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Overview"/>
   <RadioButton Content="Projetos" Style="{StaticResource Nav}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Projects"/>
   <RadioButton Content="Agentes e skills" Style="{StaticResource Nav}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Inventory"/>
   <RadioButton Content="Execução" Style="{StaticResource Nav}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Execution"/>
   <RadioButton Content="Assistente" Style="{StaticResource Nav}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Assistant"/>
   <RadioButton Content="Plugins" Style="{StaticResource Nav}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Plugins"/>
   <RadioButton Content="Descobrir" Style="{StaticResource Nav}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Discover"/>
   <RadioButton Content="Catálogo" Style="{StaticResource Nav}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Catalog"/>
   <RadioButton Content="Memórias" Style="{StaticResource Nav}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Memory"/>
   <RadioButton Content="Histórico" Style="{StaticResource Nav}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="History"/>
  </StackPanel></DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="White" Padding="28,18"><DockPanel><Button Content="Trocar projeto" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Command="{Binding NavigateCommand}" CommandParameter="Projects" IsEnabled="{Binding IsIdle}" Margin="16,0,0,0"/><StackPanel><TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding CliStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26"><ContentControl Content="{Binding}" IsEnabled="{Binding IsIdle}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource OverviewPage}"/><Style.Triggers>
    <DataTrigger Binding="{Binding Page}" Value="Inventory"><Setter Property="ContentTemplate" Value="{StaticResource InventoryPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Projects"><Setter Property="ContentTemplate" Value="{StaticResource ProjectsPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Execution"><Setter Property="ContentTemplate" Value="{StaticResource ExecutionPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Editor"><Setter Property="ContentTemplate" Value="{StaticResource EditorPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Review"><Setter Property="ContentTemplate" Value="{StaticResource ReviewPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Assistant"><Setter Property="ContentTemplate" Value="{StaticResource AssistantPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Context"><Setter Property="ContentTemplate" Value="{StaticResource ContextPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Plugins"><Setter Property="ContentTemplate" Value="{StaticResource PluginsPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Discover"><Setter Property="ContentTemplate" Value="{StaticResource DiscoverPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Catalog"><Setter Property="ContentTemplate" Value="{StaticResource CatalogPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="Memory"><Setter Property="ContentTemplate" Value="{StaticResource MemoryPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding Page}" Value="History"><Setter Property="ContentTemplate" Value="{StaticResource HistoryPage}"/></DataTrigger>
   </Style.Triggers></Style></ContentControl.Style></ContentControl></ScrollViewer>
   <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10"><DockPanel><Button Content="Cancelar operação" DockPanel.Dock="Right" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Style="{StaticResource Secondary}" Margin="12,0,0,0"/><ScrollViewer MaxHeight="85" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></ScrollViewer></DockPanel></Border>
