an/cartographer\n\n[Visão geral]   [README]   [Instalação]   [Configuração]","props":{"fontFamily":"Segoe UI","fontSize":18,"fontStyle":"Regular","fill":"#172B3A","lineHeight":"155%","textAutoResize":"height"}}},{"command":"node.create","params":{"type":"frame","parent":{"$step":12},"x":36,"y":170,"width":650,"height":450,"name":"README renderizado","props":{"fill":"#F3F5F7","cornerRadius":8,"clip":false}}},{"command":"text.create","params":{"parent":{"$step":14},"x":24,"y":22,"width":595,"text":"# Cartographer\n\n## Quando usar\nUse para construir uma visão persistente da arquitetura e relações do código.\n\n## Como funciona\nO projeto gera artefatos de mapa que o Claude pode consultar.\n\n### Limites\nConfirme runtime, permissões e arquivos criados antes de instalar.","props":{"fontFamily":"Segoe UI","fontSize":15,"fontStyle":"Regular","fill":"#172B3A","lineHeight":"155%","textAutoResize":"height"}}},{"command":"node.create","params":{"type":"frame","parent":{"$step":12},"x":716,"y":170,"width":316,"height":450,"name":"Ações e explicações","props":{"fill":"#FFF3DF","cornerRadius":8,"clip":false}}},{"command":"text.create","params":{"parent":{"$step":16},"x":20,"y":20,"width":275,"text":"POR QUE CONFIGURAR\nAjuda o Claude a localizar módulos e dependências.\n\nQUANDO CONFIGURAR\nAntes de manutenção ampla em repositório desconhecido.\n\n[Instalar]  [Configurar]\n\nAs duas ações abrem revisão com escopo, comando e efeitos esperados.","props":{"fontFamily":"Segoe UI","fontSize":14,"fontStyle":"Regular","fill":"#172B3A","lineHeight":"155%","textAutoResize":"height"}}},{"command":"node.create","params":{"type":"frame","parent":null,"x":0,"y":980,"width":1360,"height":880,"name":"19 · Ficha gerada e revisão","props":{"fill":"#F3F5F7","cornerRadius":12,"clip":false}}},{"command":"text.create","params":{"parent":{"$step":18},"x":48,"y":38,"width":1100,"text":"Ficha de catálogo preparada pelo modelo econômico","props":{"fontFamily":"Segoe UI","fontSize":30,"fontStyle":"Bold